# ================================
# Environment Variables Template
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Plane ---
PLANE_API_TOKEN=your_plane_api_token_here
PLANE_WORKSPACE_SLUG=your_workspace_slug_here
PLANE_PROJECT_ID=                          # Auto-filled after setup.py runs

# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your_username/ai-analytics-dashboard

# --- App Config ---
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# --- Agent Config ---
AGENT_MODEL=claude-opus-4-5
AGENT_MAX_TOKENS=8192
EOD_PUSH_TIME=18:00                        # End-of-day git push time (24h format)
MEMORY_RETENTION_DAYS=30                   # How long to keep conversation history
