{
  "$schema": "https://json.schemastore.org/mcp-config.json",
  "mcpServers": {
    "plane": {
      "command": "python",
      "args": [
        "-m",
        "agents.plane_agent"
      ],
      "env": {
        "PLANE_API_TOKEN": "${PLANE_API_TOKEN}",
        "PLANE_WORKSPACE_SLUG": "${PLANE_WORKSPACE_SLUG}"
      }
    },
    "github": {
      "command": "python",
      "args": [
        "-m",
        "agents.git_agent"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GITHUB_REPO": "${GITHUB_REPO}"
      }
    },
    "memory": {
      "command": "python",
      "args": [
        "-m",
        "agents.memory_manager"
      ],
      "env": {}
    },
    "browser": {
      "command": "python",
      "args": [
        "-m",
        "pytest",
        "tests/browser/"
      ],
      "env": {
        "FRONTEND_URL": "${FRONTEND_URL}",
        "BACKEND_URL": "${BACKEND_URL}"
      }
    }
  }
}
